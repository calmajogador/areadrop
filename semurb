<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Maio Amarelo - Missão Segurança no Trânsito | SEMURB</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🚦</text></svg>">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            margin: 0;
            overflow: hidden;
            font-family: 'Roboto', 'Arial', sans-serif;
            background-color: #f5f5f5;
            color: #333;
        }
        
        #game-container {
            position: relative;
            width: 100vw;
            height: 100vh;
        }
        
        #hud {
            position: absolute;
            top: 20px;
            left: 20px;
            color: #fff;
            padding: 15px;
            background-color: rgba(0, 0, 0, 0.6);
            border-radius: 10px;
            font-size: 20px;
            font-weight: bold;
            z-index: 100;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }
        
        #score {
            color: #ffcc00;
        }
        
        #lives {
            color: #ff5555;
        }
        
        #message-box {
            position: absolute;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%);
            background-color: rgba(0, 0, 0, 0.75);
            color: white;
            padding: 15px 25px;
            border-radius: 15px;
            font-size: 18px;
            text-align: center;
            max-width: 90%;
            z-index: 100;
            display: none;
            border-left: 5px solid #ffcc00;
        }
        
        #start-screen, #game-over-screen, #level-complete-screen {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            background: linear-gradient(rgba(0, 0, 0, 0.8), rgba(0, 0, 0, 0.9));
            color: white;
            text-align: center;
            z-index: 200;
        }
        
        h1 {
            font-size: 3.5rem;
            color: #ffcc00;
            margin-bottom: 20px;
            text-shadow: 3px 3px 6px rgba(0, 0, 0, 0.5);
        }
        
        h2 {
            font-size: 2rem;
            margin-bottom: 30px;
            color: #fff;
        }
        
        .logo {
            width: 200px;
            height: 200px;
            background-color: #ffcc00;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            margin-bottom: 30px;
            font-size: 4rem;
            font-weight: bold;
            color: #333;
            box-shadow: 0 10px 20px rgba(0,0,0,0.2);
        }
        
        .btn {
            background-color: #ffcc00;
            color: #333;
            border: none;
            padding: 18px 36px;
            font-size: 1.3rem;
            font-weight: bold;
            border-radius: 50px;
            cursor: pointer;
            margin: 15px;
            transition: transform 0.2s, background-color 0.2s;
            box-shadow: 0 4px 8px rgba(0,0,0,0.2);
        }
        
        .btn:hover {
            background-color: #ffd633;
            transform: scale(1.05);
            box-shadow: 0 6px 12px rgba(0,0,0,0.3);
        }
        
        .btn:active {
            transform: scale(0.98);
        }
        
        .characters {
            display: flex;
            justify-content: center;
            margin: 30px 0;
            gap: 30px;
        }
        
        .character {
            width: 120px;
            height: 160px;
            background-color: #444;
            margin: 0 15px;
            border-radius: 15px;
            overflow: hidden;
            position: relative;
            cursor: pointer;
            box-shadow: 0 5px 15px rgba(0,0,0,0.3);
            transition: transform 0.2s, box-shadow 0.2s;
        }
        
        .character:hover {
            transform: translateY(-10px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.4);
        }
        
        .character.selected {
            border: 3px solid #ffcc00;
            transform: translateY(-10px);
        }
        
        .character-name {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            background-color: rgba(0, 0, 0, 0.7);
            color: white;
            padding: 8px;
            font-size: 16px;
            font-weight: bold;
        }
        
        .character.zebrinha {
            background-color: #f9f9f9;
            background-image: linear-gradient(45deg, #333 25%, transparent 25%, transparent 50%, #333 50%, #333 75%, transparent 75%, transparent);
            background-size: 20px 20px;
        }
        
        .character.jaime {
            background-color: #ffcc00;
        }
        
        .character.detinho {
            background-color: #ffcc00;
        }
        
        #level-indicator {
            position: absolute;
            top: 20px;
            right: 20px;
            background-color: rgba(0, 0, 0, 0.6);
            color: white;
            padding: 15px;
            border-radius: 10px;
            font-size: 20px;
            font-weight: bold;
            z-index: 100;
        }
        
        .quiz-container {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background-color: rgba(0, 0, 0, 0.85);
            padding: 30px;
            border-radius: 20px;
            color: white;
            text-align: center;
            max-width: 90%;
            width: 600px;
            z-index: 150;
            display: none;
            box-shadow: 0 15px 30px rgba(0,0,0,0.4);
            border-left: 5px solid #ffcc00;
        }
        
        .quiz-question {
            font-size: 1.6rem;
            margin-bottom: 25px;
            line-height: 1.4;
        }
        
        .quiz-options {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }
        
        .quiz-option {
            background-color: #333;
            padding: 15px;
            border-radius: 10px;
            cursor: pointer;
            transition: background-color 0.3s, transform 0.1s;
            border-left: 3px solid #666;
            text-align: left;
            font-size: 1.1rem;
        }
        
        .quiz-option:hover {
            background-color: #444;
            transform: translateX(5px);
        }
        
        #game-over-screen p, #level-complete-screen p {
            font-size: 1.3rem;
            margin-bottom: 25px;
            max-width: 80%;
            line-height: 1.6;
        }
        
        .maio-amarelo-logo {
            background-color: #ffcc00;
            color: #333;
            padding: 12px 24px;
            border-radius: 8px;
            font-weight: bold;
            font-size: 1.3rem;
            margin-bottom: 30px;
            box-shadow: 0 4px 8px rgba(0,0,0,0.2);
        }
        
        #level-score {
            font-size: 1.8rem;
            margin: 20px 0;
            color: #ffcc00;
            font-weight: bold;
        }
        
        .controls-info {
            margin-top: 20px;
            font-size: 1.1rem;
            color: #ccc;
        }
        
        .semurb-logo {
            margin-top: 30px;
            font-size: 1.2rem;
            color: #888;
        }
        
        .info-section {
            margin-top: 20px;
            max-width: 80%;
            text-align: center;
            line-height: 1.6;
            color: #ccc;
        }
        
        .footer {
            position: absolute;
            bottom: 10px;
            width: 100%;
            text-align: center;
            color: #888;
            font-size: 0.9rem;
        }
        
        @media (max-width: 768px) {
            h1 {
                font-size: 2.5rem;
            }
            
            h2 {
                font-size: 1.5rem;
            }
            
            .logo {
                width: 150px;
                height: 150px;
                font-size: 3rem;
            }
            
            .character {
                width: 80px;
                height: 120px;
            }
            
            .btn {
                padding: 15px 30px;
                font-size: 1.1rem;
            }
            
            .quiz-question {
                font-size: 1.3rem;
            }
        }

        /* Mobile controls */
        .mobile-controls {
            position: absolute;
            bottom: 20px;
            left: 0;
            right: 0;
            display: none;
            justify-content: center;
            gap: 50px;
            z-index: 100;
        }
        
        .mobile-control-btn {
            width: 80px;
            height: 80px;
            background-color: rgba(255, 255, 255, 0.3);
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 40px;
            color: white;
            user-select: none;
            touch-action: manipulation;
        }
        
        .mobile-left {
            transform: rotate(180deg);
        }
        
        @media (max-width: 1024px) {
            .mobile-controls {
                display: flex;
            }
        }
    </style>
</head>
<body>
    <div id="game-container">
        <div id="hud">
            <div id="score">Pontos: 0</div>
            <div id="lives">Vidas: 3</div>
        </div>
        <div id="level-indicator">Nível: 1</div>
        <div id="message-box"></div>
        
        <div class="mobile-controls">
            <div class="mobile-control-btn mobile-left" id="mobile-left">➤</div>
            <div class="mobile-control-btn mobile-right" id="mobile-right">➤</div>
        </div>
        
        <div id="start-screen">
            <div class="logo">MA</div>
            <h1>Maio Amarelo</h1>
            <h2>Missão Segurança no Trânsito</h2>
            <div class="maio-amarelo-logo">Atenção pela vida, responsabilidade no trânsito!</div>
            
            <div class="characters">
                <div class="character zebrinha selected" data-character="zebrinha">
                    <div class="character-name">Zebrinha</div>
                </div>
                <div class="character jaime" data-character="jaime">
                    <div class="character-name">Jaime</div>
                </div>
                <div class="character detinho" data-character="detinho">
                    <div class="character-name">Detinho</div>
                </div>
            </div>
            
            <p>Aprenda sobre regras de trânsito enquanto se diverte!</p>
            <button id="start-btn" class="btn">Iniciar Jogo</button>
            
            <div class="controls-info">
                Use as setas ← → para mover seu personagem
            </div>
            
            <div class="info-section">
                O Maio Amarelo é um movimento internacional de conscientização para 
                redução de acidentes no trânsito. Junte-se a esta causa!
            </div>
            
            <div class="semurb-logo">
                SEMURB - Secretaria Municipal de Urbanismo
            </div>
            
            <div class="footer">
                © 2025 - Todos os direitos reservados
            </div>
        </div>
        
        <div id="game-over-screen" style="display: none;">
            <h1>Game Over</h1>
            <p>Você não conseguiu completar a missão de segurança no trânsito. Mas não desista, a segurança no trânsito depende de todos nós!</p>
            <button id="restart-btn" class="btn">Tentar Novamente</button>
        </div>
        
        <div id="level-complete-screen" style="display: none;">
            <h1>Nível Completo!</h1>
            <p>Parabéns! Você completou este nível da missão de segurança no trânsito. Continue aprendendo e praticando atitudes seguras!</p>
            <div id="level-score">Pontuação: 0</div>
            <button id="next-level-btn" class="btn">Próximo Nível</button>
        </div>
        
        <div class="quiz-container" id="quiz-container">
            <div class="quiz-question" id="quiz-question"></div>
            <div class="quiz-options" id="quiz-options"></div>
        </div>
    </div>

    <script>
        // Variáveis do jogo
        let scene, camera, renderer, player;
        let obstacles = [];
        let collectibles = [];
        let score = 0;
        let lives = 3;
        let level = 1;
        let isGameActive = false;
        let animationId = null;
        let characterModel = 'zebrinha'; // Personagem padrão
        
        // Perguntas do quiz sobre segurança no trânsito e Maio Amarelo
        const quizQuestions = [
            {
                question: "Qual o significado do Movimento Maio Amarelo?",
                options: [
                    "Campanha para economia de combustível",
                    "Ação para conscientização e redução de acidentes de trânsito",
                    "Movimento para incentivar o uso de transportes públicos",
                    "Programa de manutenção de semáforos"
                ],
                correctIndex: 1
            },
            {
                question: "Por que a cor amarela foi escolhida para o movimento?",
                options: [
                    "Porque é a cor da felicidade",
                    "Porque é a cor do sol",
                    "Porque simboliza atenção no trânsito",
                    "Porque é a cor mais visível à noite"
                ],
                correctIndex: 2
            },
            {
                question: "Qual destas NÃO é uma regra de segurança para pedestres?",
                options: [
                    "Atravessar na faixa de pedestres",
                    "Atravessar em qualquer local da via quando não houver carros",
                    "Olhar para os dois lados antes de atravessar",
                    "Esperar o semáforo ficar verde para pedestres"
                ],
                correctIndex: 1
            },
            {
                question: "O que significa uma placa de trânsito na cor vermelha e formato circular?",
                options: [
                    "Indica direção obrigatória",
                    "Informa sobre condições da pista",
                    "Sinaliza obras na via",
                    "Proibição ou restrição"
                ],
                correctIndex: 3
            },
            {
                question: "Qual equipamento é obrigatório para ciclistas conforme o Código de Trânsito?",
                options: [
                    "Capacete de segurança",
                    "Luvas especiais",
                    "Campainha e refletores",
                    "Capa de chuva"
                ],
                correctIndex: 2
            },
            {
                question: "Qual o limite de velocidade em vias urbanas sem sinalização específica?",
                options: [
                    "80 km/h",
                    "60 km/h",
                    "40 km/h",
                    "30 km/h"
                ],
                correctIndex: 1
            },
            {
                question: "Qual ação é proibida ao dirigir?",
                options: [
                    "Usar o cinto de segurança",
                    "Usar o celular mesmo que no viva-voz",
                    "Respeitar o limite de velocidade",
                    "Dar passagem aos pedestres na faixa"
                ],
                correctIndex: 1
            },
            {
                question: "Quando o movimento Maio Amarelo começou no Brasil?",
                options: [
                    "2010",
                    "2013",
                    "2015",
                    "2020"
                ],
                correctIndex: 1
            },
            {
                question: "O que significa a faixa de pedestres?",
                options: [
                    "Local exclusivo para estacionamento",
                    "Área destinada à travessia segura de pedestres",
                    "Local para motos pararem nos semáforos",
                    "Área exclusiva para ciclistas"
                ],
                correctIndex: 1
            },
            {
                question: "Qual a importância do cinto de segurança?",
                options: [
                    "Apenas evitar multas de trânsito",
                    "Prevenir lesões em caso de acidentes",
                    "Melhorar a aparência do veículo",
                    "Apenas para conforto do motorista"
                ],
                correctIndex: 1
            }
        ];
        
        // Inicializar o jogo quando a página carregar
        document.getElementById('start-btn').addEventListener('click', function() {
            document.getElementById('start-screen').style.display = 'none';
            initGame();
        });
        
        document.getElementById('restart-btn').addEventListener('click', function() {
            document.getElementById('game-over-screen').style.display = 'none';
            resetGame();
            initGame();
        });
        
        document.getElementById('next-level-btn').addEventListener('click', function() {
            document.getElementById('level-complete-screen').style.display = 'none';
            level++;
            resetLevel();
            initLevel();
        });
        
        // Configurar seleção de personagem
        document.querySelectorAll('.character').forEach(characterElement => {
            characterElement.addEventListener('click', function() {
                // Remover seleção anterior
                document.querySelectorAll('.character').forEach(el => {
                    el.classList.remove('selected');
                });
                
                // Adicionar seleção ao personagem clicado
                this.classList.add('selected');
                
                // Atualizar personagem selecionado
                characterModel = this.getAttribute('data-character');
                
                // Atualizar player se o jogo já estiver iniciado
                if (player) createPlayer();
            });
        });
        
        // Controles móveis
        document.getElementById('mobile-left').addEventListener('touchstart', function(e) {
            e.preventDefault();
            handleMobileControl('left');
        });
        
        document.getElementById('mobile-right').addEventListener('touchstart', function(e) {
            e.preventDefault();
            handleMobileControl('right');
        });
        
        function handleMobileControl(direction) {
            if (!isGameActive) return;
            
            const moveSpeed = 0.5;
            
            if (direction === 'left' && player.position.x > -4) {
                player.position.x -= moveSpeed;
            } else if (direction === 'right' && player.position.x < 4) {
                player.position.x += moveSpeed;
            }
        }
        
        // Função para inicializar o jogo
        function initGame() {
            // Configurar a cena Three.js
            scene = new THREE.Scene();
            scene.background = new THREE.Color(0x87CEEB); // Cor do céu
            
            // Configurar a câmera
            camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
            camera.position.set(0, 5, 10);
            camera.lookAt(0, 0, 0);
            
            // Configurar o renderizador
            renderer = new THREE.WebGLRenderer({ antialias: true });
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.shadowMap.enabled = true;
            document.getElementById('game-container').appendChild(renderer.domElement);
            
            // Adicionar luz
            const ambientLight = new THREE.AmbientLight(0xffffff, 0.6);
            scene.add(ambientLight);
            
            const directionalLight = new THREE.DirectionalLight(0xffffff, 0.8);
            directionalLight.position.set(10, 20, 5);
            directionalLight.castShadow = true;
            scene.add(directionalLight);
            
            // Criar o cenário
            createEnvironment();
            
            // Criar o jogador (baseado no personagem selecionado)
            createPlayer();
            
            // Inicializar o nível
            resetGame();
            initLevel();
            
            // Iniciar o loop de animação
            isGameActive = true;
            animate();
            
            // Adicionar eventos de teclado
            window.addEventListener('keydown', handleKeyDown);
            window.addEventListener('resize', onWindowResize);
            
            // Exibir mensagem inicial
            showMessage("Use as setas ← → para se mover e evite os obstáculos!", 5000);
        }
        
        function createEnvironment() {
            // Criar o chão (estrada)
            const roadGeometry = new THREE.PlaneGeometry(10, 100);
            const roadMaterial = new THREE.MeshStandardMaterial({ 
                color: 0x333333,
                roughness: 0.8
            });
            const road = new THREE.Mesh(roadGeometry, roadMaterial);
            road.rotation.x = -Math.PI / 2;
            road.position.z = -45;
            road.receiveShadow = true;
            scene.add(road);
            
            // Adicionar faixas na estrada
            for (let i = -45; i < 5; i += 5) {
                const stripeGeometry = new THREE.PlaneGeometry(0.5, 2);
                const stripeMaterial = new THREE.MeshStandardMaterial({ color: 0xffffff });
                const stripe = new THREE.Mesh(stripeGeometry, stripeMaterial);
                stripe.rotation.x = -Math.PI / 2;
                stripe.position.set(0, 0.01, i);
                scene.add(stripe);
            }
            
            // Adicionar cenário nas laterais (grama)
            const grassGeometry = new THREE.PlaneGeometry(50, 100);
            const grassMaterial = new THREE.MeshStandardMaterial({ color: 0x4CAF50 });
            
            const leftGrass = new THREE.Mesh(grassGeometry, grassMaterial);
            leftGrass.rotation.x = -Math.PI / 2;
            leftGrass.position.set(-25, -0.01, -45);
            scene.add(leftGrass);
            
            const rightGrass = new THREE.Mesh(grassGeometry, grassMaterial);
            rightGrass.rotation.x = -Math.PI / 2;
            rightGrass.position.set(25, -0.01, -45);
            scene.add(rightGrass);
            
            // Adicionar árvores e postes de iluminação nas laterais
            for (let i = -45; i < 5; i += 15) {
                createTreeOrLamp(i, true); // Esquerda
                createTreeOrLamp(i, false); // Direita
            }
        }
        
        function createTreeOrLamp(zPosition, isLeft) {
            const side = isLeft ? -8 : 8;
            
            if (Math.random() > 0.5) {
                // Criar árvore
                const trunkGeometry = new THREE.CylinderGeometry(0.3, 0.4, 2, 8);
                const trunkMaterial = new THREE.MeshStandardMaterial({ color: 0x8B4513 });
                const trunk = new THREE.Mesh(trunkGeometry, trunkMaterial);
                trunk.position.set(side, 1, zPosition);
                trunk.castShadow = true;
                scene.add(trunk);
                
                const leavesGeometry = new THREE.ConeGeometry(2, 4, 8);
                const leavesMaterial = new THREE.MeshStandardMaterial({ color: 0x228B22 });
                const leaves = new THREE.Mesh(leavesGeometry, leavesMaterial);
                leaves.position.set(side, 4, zPosition);
                leaves.castShadow = true;
                scene.add(leaves);
            } else {
                // Criar poste de iluminação
                const poleGeometry = new THREE.CylinderGeometry(0.2, 0.2, 5, 8);
                const poleMaterial = new THREE.MeshStandardMaterial({ color: 0x555555 });
                const pole = new THREE.Mesh(poleGeometry, poleMaterial);
                pole.position.set(side, 2.5, zPosition);
                pole.castShadow = true;
                scene.add(pole);
                
                const lampGeometry = new THREE.SphereGeometry(0.5, 16, 16);
                const lampMaterial = new THREE.MeshStandardMaterial({ 
                    color: 0xFFFF99,
                    emissive: 0xFFFF99,
                    emissiveIntensity: 0.5
                });
                const lamp = new THREE.Mesh(lampGeometry, lampMaterial);
                lamp.position.set(side, 5, zPosition);
                scene.add(lamp);
                
                // Adicionar luz no poste
                const light = new THREE.PointLight(0xFFFF99, 1, 10);
                light.position.set(side, 5, zPosition);
                scene.add(light);
            }
        }
        
        function createPlayer() {
            // Remover jogador anterior se existir
            if (player) {
                scene.remove(player);
            }
            
            // Grupo principal do personagem
            player = new THREE.Group();
            player.position.set(0, 0.5, 0);
            
            // Cores baseadas no personagem
            let playerColor;
            
            switch(characterModel) {
                case 'zebrinha':
                    createZebrinhaModel();
                    break;
                case 'jaime':
                    createJaimeModel();
                    break;
                case 'detinho':
                    createDetinhoModel();
                    break;
                default:
                    createZebrinhaModel();
            }
            
            player.castShadow = true;
            scene.add(player);
            
            // Funções para criar modelos específicos
            function createZebrinhaModel() {
                // Corpo da zebrinha
                const bodyGeometry = new THREE.BoxGeometry(1, 1, 1.5);
                const bodyMaterial = new THREE.MeshStandardMaterial({ color: 0xEEEEEE });
                const body = new THREE.Mesh(bodyGeometry, bodyMaterial);
                body.position.y = 0.5;
                player.add(body);
                
                // Adicionar listras
                for (let i = -0.6; i <= 0.6; i += 0.3) {
                    const stripeGeometry = new THREE.BoxGeometry(1.01, 0.2, 1.51);
                    const stripeMaterial = new THREE.MeshStandardMaterial({ color: 0x333333 });
                    const stripe = new THREE.Mesh(stripeGeometry, stripeMaterial);
                    stripe.position.y = 0.5 + i;
                    stripe.position.z = 0;
                    body.add(stripe);
                }
                
                // Cabeça da zebrinha
                const headGeometry = new THREE.SphereGeometry(0.6, 16, 16);
                const headMaterial = new THREE.MeshStandardMaterial({ color: 0xEEEEEE });
                const head = new THREE.Mesh(headGeometry, headMaterial);
                head.position.y = 1.3;
                head.position.z = 0.5;
                player.add(head);
                
                // Olhos
                const eyeGeometry = new THREE.SphereGeometry(0.1, 8, 8);
                const eyeMaterial = new THREE.MeshStandardMaterial({ color: 0x000000 });
                const leftEye = new THREE.Mesh(eyeGeometry, eyeMaterial);
                leftEye.position.set(-0.2, 1.4, 0.9);
                player.add(leftEye);
                const rightEye = new THREE.Mesh(eyeGeometry, eyeMaterial);
                rightEye.position.set(0.2, 1.4, 0.9);
                player.add(rightEye);
            }
            
            function createJaimeModel() {
                // Corpo do Jaime (personagem amarelo)
                const bodyGeometry = new THREE.BoxGeometry(1, 1, 1.5);
                const bodyMaterial = new THREE.MeshStandardMaterial({ color: 0xFFCC00 });
                const body = new THREE.Mesh(bodyGeometry, bodyMaterial);
                body.position.y = 0.5;
                player.add(body);
                
                // Cabeça
                const headGeometry = new THREE.SphereGeometry(0.6, 16, 16);
                const headMaterial = new THREE.MeshStandardMaterial({ color: 0xFFCC00 });
                const head = new THREE.Mesh(headGeometry, headMaterial);
                head.position.y = 1.3;
                head.position.z = 0.5;
                player.add(head);
                
                // Olhos
                const eyeGeometry = new THREE.SphereGeometry(0.1, 8, 8);
                const eyeMaterial = new THREE.MeshStandardMaterial({ color: 0x000000 });
                const leftEye = new THREE.Mesh(eyeGeometry, eyeMaterial);
                leftEye.position.set(-0.2, 1.4, 0.9);
                player.add(leftEye);
                const rightEye = new THREE.Mesh(eyeGeometry, eyeMaterial);
                rightEye.position.set(0.2, 1.4, 0.9);
                player.add(rightEye);
                
                // Colete refletivo
                const vestGeometry = new THREE.BoxGeometry(1.1, 0.6, 1.6);
                const vestMaterial = new THREE.MeshStandardMaterial({ 
                    color: 0xFF6600,
                    emissive: 0xFF3300,
                    emissiveIntensity: 0.2
                });
                const vest = new THREE.Mesh(vestGeometry, vestMaterial);
                vest.position.y = 0.7;
                player.add(vest);
            }
            
            function createDetinhoModel() {
                // Corpo do Detinho (detetive de trânsito)
                const bodyGeometry = new THREE.BoxGeometry(1, 1, 1.5);
                const bodyMaterial = new THREE.MeshStandardMaterial({ color: 0x2E7D32 });
                const body = new THREE.Mesh(bodyGeometry, bodyMaterial);
                body.position.y = 0.5;
                player.add(body);
                
                // Cabeça
                const headGeometry = new THREE.SphereGeometry(0.6, 16, 16);
                const headMaterial = new THREE.MeshStandardMaterial({ color: 0xFFDBAE });
                const head = new THREE.Mesh(headGeometry, headMaterial);
                head.position.y = 1.3;
                head.position.z = 0.5;
                player.add(head);
                
                // Chapéu de policial
                const hatGeometry = new THREE.CylinderGeometry(0.5, 0.7, 0.3, 16);
                const hatMaterial = new THREE.MeshStandardMaterial({ color: 0x1A237E });
                const hat = new THREE.Mesh(hatGeometry, hatMaterial);
                hat.position.y = 1.8;
                hat.position.z = 0.5;
                player.add(hat);
                
                // Olhos
                const eyeGeometry = new THREE.SphereGeometry(0.1, 8, 8);
                const eyeMaterial = new THREE.MeshStandardMaterial({ color: 0x000000 });
                const leftEye = new THREE.Mesh(eyeGeometry, eyeMaterial);
                leftEye.position.set(-0.2, 1.4, 0.9);
                player.add(leftEye);
                const rightEye = new THREE.Mesh(eyeGeometry, eyeMaterial);
                rightEye.position.set(0.2, 1.4, 0.9);
                player.add(rightEye);
                
                // Distintivo
                const badgeGeometry = new THREE.CircleGeometry(0.2, 8);
                const badgeMaterial = new THREE.MeshStandardMaterial({ 
                    color: 0xFFD700,
                    emissive: 0xFFD700,
                    emissiveIntensity: 0.3
                });
                const badge = new THREE.Mesh(badgeGeometry, badgeMaterial);
                badge.position.set(-0.3, 0.7, 0.76);
                player.add(badge);
            }
        }
        
        function createObstacle(x, z) {
            const obstacleTypes = ['car', 'cone', 'barrier'];
            const type = obstacleTypes[Math.floor(Math.random() * obstacleTypes.length)];
            
            let obstacle;
            
            switch(type) {
                case 'car':
                    obstacle = createCar();
                    break;
                case 'cone':
                    obstacle = createCone();
                    break;
                case 'barrier':
                    obstacle = createBarrier();
                    break;
            }
            
            obstacle.position.set(x, 0, z);
            obstacle.userData = { type: 'obstacle' };
            scene.add(obstacle);
            obstacles.push(obstacle);
            
            return obstacle;
            
            function createCar() {
                const car = new THREE.Group();
                
                // Corpo do carro
                const bodyGeometry = new THREE.BoxGeometry(2, 1, 4);
                const colors = [0xFF0000, 0x0000FF, 0x00FF00, 0xFFFF00, 0xFF00FF];
                const bodyMaterial = new THREE.MeshStandardMaterial({ 
                    color: colors[Math.floor(Math.random() * colors.length)]
                });
                const body = new THREE.Mesh(bodyGeometry, bodyMaterial);
                body.position.y = 0.5;
                body.castShadow = true;
                car.add(body);
                
                // Teto do carro
                const roofGeometry = new THREE.BoxGeometry(1.8, 0.8, 2);
                const roofMaterial = new THREE.MeshStandardMaterial({ color: 0x333333 });
                const roof = new THREE.Mesh(roofGeometry, roofMaterial);
                roof.position.y = 1.4;
                roof.position.z = 0.5;
                roof.castShadow = true;
                car.add(roof);
                
                // Rodas
                const wheelGeometry = new THREE.CylinderGeometry(0.3, 0.3, 0.2, 16);
                const wheelMaterial = new THREE.MeshStandardMaterial({ color: 0x333333 });
                
                const wheel1 = new THREE.Mesh(wheelGeometry, wheelMaterial);
                wheel1.position.set(-1.2, 0.3, 1.5);
                wheel1.rotation.z = Math.PI / 2;
                car.add(wheel1);
                
                const wheel2 = new THREE.Mesh(wheelGeometry, wheelMaterial);
                wheel2.position.set(1.2, 0.3, 1.5);
                wheel2.rotation.z = Math.PI / 2;
                car.add(wheel2);
                
                const wheel3 = new THREE.Mesh(wheelGeometry, wheelMaterial);
                wheel3.position.set(-1.2, 0.3, -1.5);
                wheel3.rotation.z = Math.PI / 2;
                car.add(wheel3);
                
                const wheel4 = new THREE.Mesh(wheelGeometry, wheelMaterial);
                wheel4.position.set(1.2, 0.3, -1.5);
                wheel4.rotation.z = Math.PI / 2;
                car.add(wheel4);
                
                return car;
            }
            
            function createCone() {
                const cone = new THREE.Group();
                
                const coneGeometry = new THREE.ConeGeometry(0.5, 1.5, 8);
                const coneMaterial = new THREE.MeshStandardMaterial({ color: 0xFF6600 });
                const coneMesh = new THREE.Mesh(coneGeometry, coneMaterial);
                coneMesh.position.y = 0.75;
                coneMesh.castShadow = true;
                cone.add(coneMesh);
                
                // Listras reflexivas
                for (let i = 0; i < 3; i++) {
                    const stripeGeometry = new THREE.RingGeometry(0.3, 0.5, 8);
                    const stripeMaterial = new THREE.MeshStandardMaterial({ 
                        color: 0xFFFFFF,
                        emissive: 0xFFFFFF,
                        emissiveIntensity: 0.3
                    });
                    const stripe = new THREE.Mesh(stripeGeometry, stripeMaterial);
                    stripe.position.y = 0.3 + (i * 0.4);
                    stripe.rotation.x = Math.PI / 2;
                    cone.add(stripe);
                }
                
                return cone;
            }
            
            function createBarrier() {
                const barrier = new THREE.Group();
                
                const barrierGeometry = new THREE.BoxGeometry(3, 1, 0.3);
                const barrierMaterial = new THREE.MeshStandardMaterial({ color: 0xFF0000 });
                const barrierMesh = new THREE.Mesh(barrierGeometry, barrierMaterial);
                barrierMesh.position.y = 0.5;
                barrierMesh.castShadow = true;
                barrier.add(barrierMesh);
                
                // Listras brancas
                for (let i = -1; i <= 1; i += 0.5) {
                    const stripeGeometry = new THREE.BoxGeometry(0.3, 1.1, 0.31);
                    const stripeMaterial = new THREE.MeshStandardMaterial({ color: 0xFFFFFF });
                    const stripe = new THREE.Mesh(stripeGeometry, stripeMaterial);
                    stripe.position.set(i, 0.5, 0);
                    barrier.add(stripe);
                }
                
                return barrier;
            }
        }
        
        function createCollectible(x, z) {
            const collectible = new THREE.Group();
            
            // Moeda amarela (representando conhecimento de trânsito)
            const coinGeometry = new THREE.CylinderGeometry(0.3, 0.3, 0.1, 16);
            const coinMaterial = new THREE.MeshStandardMaterial({ 
                color: 0xFFD700,
                emissive: 0xFFD700,
                emissiveIntensity: 0.3
            });
            const coin = new THREE.Mesh(coinGeometry, coinMaterial);
            coin.position.y = 1;
            coin.castShadow = true;
            collectible.add(coin);
            
            // Símbolo de trânsito na moeda
            const symbolGeometry = new THREE.RingGeometry(0.15, 0.25, 16);
            const symbolMaterial = new THREE.MeshStandardMaterial({ 
                color: 0x000000,
                emissive: 0x333333,
                emissiveIntensity: 0.1
            });
            const symbol = new THREE.Mesh(symbolGeometry, symbolMaterial);
            symbol.position.y = 1.05;
            symbol.rotation.x = Math.PI / 2;
            collectible.add(symbol);
            
            collectible.position.set(x, 0, z);
            collectible.userData = { type: 'collectible', rotation: 0 };
            scene.add(collectible);
            collectibles.push(collectible);
            
            return collectible;
        }
        
        function initLevel() {
            // Limpar obstáculos e coletáveis anteriores
            obstacles.forEach(obstacle => scene.remove(obstacle));
            collectibles.forEach(collectible => scene.remove(collectible));
            obstacles = [];
            collectibles = [];
            
            // Criar novos obstáculos e coletáveis baseados no nível
            const numObstacles = 8 + (level * 2);
            const numCollectibles = 5 + level;
            
            // Criar obstáculos
            for (let i = 0; i < numObstacles; i++) {
                const x = (Math.random() - 0.5) * 8;
                const z = -10 - (i * 8) - Math.random() * 5;
                createObstacle(x, z);
            }
            
            // Criar coletáveis
            for (let i = 0; i < numCollectibles; i++) {
                const x = (Math.random() - 0.5) * 8;
                const z = -15 - (i * 10) - Math.random() * 5;
                createCollectible(x, z);
            }
            
            updateHUD();
            updateLevelIndicator();
        }
        
        function animate() {
            if (!isGameActive) return;
            
            animationId = requestAnimationFrame(animate);
            
            // Mover obstáculos e coletáveis em direção ao jogador
            const moveSpeed = 0.1 + (level * 0.02);
            
            obstacles.forEach((obstacle, index) => {
                obstacle.position.z += moveSpeed;
                
                // Remover obstáculos que passaram do jogador
                if (obstacle.position.z > 5) {
                    scene.remove(obstacle);
                    obstacles.splice(index, 1);
                }
            });
            
            collectibles.forEach((collectible, index) => {
                collectible.position.z += moveSpeed;
                
                // Rotacionar coletáveis
                collectible.userData.rotation += 0.05;
                collectible.rotation.y = collectible.userData.rotation;
                
                // Fazer coletáveis flutuarem
                collectible.position.y = 1 + Math.sin(Date.now() * 0.005 + index) * 0.2;
                
                // Remover coletáveis que passaram do jogador
                if (collectible.position.z > 5) {
                    scene.remove(collectible);
                    collectibles.splice(index, 1);
                }
            });
            
            // Verificar colisões
            checkCollisions();
            
            // Verificar se o nível foi completado
            if (obstacles.length === 0 && collectibles.length === 0) {
                completeLevel();
            }
            
            // Gerar novos obstáculos e coletáveis conforme necessário
            if (Math.random() < 0.02) {
                const x = (Math.random() - 0.5) * 8;
                createObstacle(x, -100);
            }
            
            if (Math.random() < 0.01) {
                const x = (Math.random() - 0.5) * 8;
                createCollectible(x, -100);
            }
            
            renderer.render(scene, camera);
        }
        
        function checkCollisions() {
            const playerBounds = new THREE.Box3().setFromObject(player);
            
            // Verificar colisão com obstáculos
            obstacles.forEach((obstacle, index) => {
                const obstacleBounds = new THREE.Box3().setFromObject(obstacle);
                
                if (playerBounds.intersectsBox(obstacleBounds)) {
                    // Colisão detectada
                    lives--;
                    updateHUD();
                    
                    // Remover obstáculo
                    scene.remove(obstacle);
                    obstacles.splice(index, 1);
                    
                    // Mostrar mensagem de colisão
                    showMessage("Cuidado! Lembre-se sempre das regras de segurança no trânsito!", 3000);
                    
                    if (lives <= 0) {
                        gameOver();
                    } else {
                        // Mostrar quiz sobre segurança no trânsito
                        showQuiz();
                    }
                }
            });
            
            // Verificar colisão com coletáveis
            collectibles.forEach((collectible, index) => {
                const collectibleBounds = new THREE.Box3().setFromObject(collectible);
                
                if (playerBounds.intersectsBox(collectibleBounds)) {
                    // Coletável coletado
                    score += 100 + (level * 50);
                    updateHUD();
                    
                    // Remover coletável
                    scene.remove(collectible);
                    collectibles.splice(index, 1);
                    
                    // Mostrar mensagem positiva
                    const messages = [
                        "Excelente! Conhecimento é fundamental para um trânsito seguro!",
                        "Muito bem! Continue aprendendo sobre segurança no trânsito!",
                        "Parabéns! O Maio Amarelo agradece sua participação!",
                        "Ótimo! Cada atitude consciente salva vidas no trânsito!"
                    ];
                    showMessage(messages[Math.floor(Math.random() * messages.length)], 2000);
                }
            });
        }
        
        function showQuiz() {
            isGameActive = false;
            
            const randomQuestion = quizQuestions[Math.floor(Math.random() * quizQuestions.length)];
            
            document.getElementById('quiz-question').textContent = randomQuestion.question;
            
            const optionsContainer = document.getElementById('quiz-options');
            optionsContainer.innerHTML = '';
            
            randomQuestion.options.forEach((option, index) => {
                const optionElement = document.createElement('div');
                optionElement.className = 'quiz-option';
                optionElement.textContent = option;
                optionElement.addEventListener('click', () => {
                    handleQuizAnswer(index === randomQuestion.correctIndex);
                });
                optionsContainer.appendChild(optionElement);
            });
            
            document.getElementById('quiz-container').style.display = 'block';
        }
        
        function handleQuizAnswer(isCorrect) {
            document.getElementById('quiz-container').style.display = 'none';
            
            if (isCorrect) {
                score += 200;
                lives = Math.min(lives + 1, 5); // Máximo de 5 vidas
                showMessage("Resposta correta! Você ganhou uma vida extra e pontos bônus!", 3000);
            } else {
                showMessage("Resposta incorreta, mas continue aprendendo sobre segurança no trânsito!", 3000);
            }
            
            updateHUD();
            isGameActive = true;
            animate();
        }
        
        function handleKeyDown(event) {
            if (!isGameActive) return;
            
            const moveSpeed = 0.5;
            
            switch(event.code) {
                case 'ArrowLeft':
                    if (player.position.x > -4) {
                        player.position.x -= moveSpeed;
                    }
                    break;
                case 'ArrowRight':
                    if (player.position.x < 4) {
                        player.position.x += moveSpeed;
                    }
                    break;
            }
        }
        
        function showMessage(text, duration) {
            const messageBox = document.getElementById('message-box');
            messageBox.textContent = text;
            messageBox.style.display = 'block';
            
            setTimeout(() => {
                messageBox.style.display = 'none';
            }, duration);
        }
        
        function updateHUD() {
            document.getElementById('score').textContent = `Pontos: ${score}`;
            document.getElementById('lives').textContent = `Vidas: ${lives}`;
        }
        
        function updateLevelIndicator() {
            document.getElementById('level-indicator').textContent = `Nível: ${level}`;
        }
        
        function completeLevel() {
            isGameActive = false;
            cancelAnimationFrame(animationId);
            
            const levelBonus = level * 500;
            score += levelBonus;
            
            document.getElementById('level-score').textContent = `Pontuação: ${score}`;
            document.getElementById('level-complete-screen').style.display = 'flex';
        }
        
        function gameOver() {
            isGameActive = false;
            cancelAnimationFrame(animationId);
            document.getElementById('game-over-screen').style.display = 'flex';
        }
        
        function resetGame() {
            score = 0;
            lives = 3;
            level = 1;
            updateHUD();
            updateLevelIndicator();
        }
        
        function resetLevel() {
            // Resetar posição do jogador
            if (player) {
                player.position.set(0, 0.5, 0);
            }
            
            // Limpar obstáculos e coletáveis
            obstacles.forEach(obstacle => scene.remove(obstacle));
            collectibles.forEach(collectible => scene.remove(collectible));
            obstacles = [];
            collectibles = [];
        }
        
        function onWindowResize() {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        }
        
        // Prevenir zoom no mobile ao fazer double tap
        document.addEventListener('touchstart', function(event) {
            if (event.touches.length > 1) {
                event.preventDefault();
            }
        }, { passive: false });
        
        let lastTouchEnd = 0;
        document.addEventListener('touchend', function(event) {
            const now = (new Date()).getTime();
            if (now - lastTouchEnd <= 300) {
                event.preventDefault();
            }
            lastTouchEnd = now;
        }, false);
    </script>
</body>
